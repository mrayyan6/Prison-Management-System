<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.prison.controller.CommissaryController"
      spacing="12" style="-fx-padding: 20; -fx-background-color: #0f172a;">

    <Label text="Inmate Shop - Commissary" style="-fx-text-fill: #f8fafc; -fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label text="Select an inmate and item. Purchases deduct balance automatically." style="-fx-text-fill: #cbd5e1;"/>

    <HBox spacing="10">
        <Label text="Inmate:" style="-fx-text-fill: #e2e8f0;"/>
        <ComboBox fx:id="inmateCombo" prefWidth="320"/>
        <Label fx:id="inmateBalanceLabel" text="Current Balance: --" style="-fx-text-fill: #f8fafc; -fx-font-size: 14px; -fx-font-weight: bold;"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Category:" style="-fx-text-fill: #e2e8f0;"/>
        <ComboBox fx:id="categoryCombo" prefWidth="220"/>
        <Label fx:id="selectedItemLabel" text="Selected Item: None" style="-fx-text-fill: #cbd5e1;"/>
    </HBox>

    <ScrollPane fx:id="itemsScrollPane" fitToWidth="true" prefHeight="390" style="-fx-background: #111827;">
        <content>
            <TilePane fx:id="itemsTilePane" hgap="10" vgap="10" prefColumns="3"/>
        </content>
    </ScrollPane>

    <HBox spacing="10">
        <Button text="Purchase Selected Item" onAction="#purchaseSelectedItem"
                style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Request Phone Call" onAction="#requestPhoneCall"
            style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Label fx:id="countdownLabel" text="Call Timer: Idle" style="-fx-text-fill: #e2e8f0; -fx-font-weight: bold;"/>
        <Button text="Back" onAction="#goBack"/>
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold;"/>
</VBox>