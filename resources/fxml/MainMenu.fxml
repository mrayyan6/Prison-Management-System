<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.prison.controller.MainMenuController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <left>
        <VBox fx:id="sidebar" spacing="10" prefWidth="260"
              style="-fx-background-color: #111827; -fx-padding: 20; -fx-border-color: #334155; -fx-border-width: 0 1 0 0;">
            <Label text="Navigation" style="-fx-text-fill: #e2e8f0; -fx-font-size: 20px; -fx-font-weight: bold;"/>

            <Button fx:id="registerInmateBtn" text="Register Inmate" onAction="#openRegisterInmate" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="manageStaffBtn" text="Manage Staff" onAction="#openManageStaff" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="assignWorkBtn" text="Assign Work" onAction="#openAssignWork" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="manageResourcesBtn" text="Manage Resources" onAction="#openManageResources" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="medicalCheckupBtn" text="Medical Checkup" onAction="#openMedicalCheckup" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="monitorAttendanceBtn" text="Monitor Attendance" onAction="#openMonitorAttendance" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="incidentReportBtn" text="Incident Report" onAction="#openIncidentReport" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="recordMovementBtn" text="Record Movement" onAction="#openRecordMovement" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="releaseInmateBtn" text="Release Inmate" onAction="#openReleaseInmate" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="commissaryBtn" text="Commissary Shop" onAction="#openCommissary" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="predictiveRiskBtn" text="Predictive Risk Analysis" onAction="#openPredictiveRisk" prefWidth="220"
                    style="-fx-background-color: #1f2937; -fx-text-fill: #f8fafc; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="financialServicesBtn" text="Financial Services" onAction="#openFinancialServices" prefWidth="220"
                    style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="publicIncidentReportsBtn" text="Inmate Incident + Release" onAction="#openVisitorIncidentReports" prefWidth="220"
                    style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

                        <Button text="Logout" onAction="#handleLogout" prefWidth="220"
                    style="-fx-background-color: #991b1b; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
                <VBox alignment="TOP_LEFT" spacing="16" style="-fx-padding: 28;">
            <Label text="Prison Management Control Center" style="-fx-text-fill: #f8fafc; -fx-font-size: 34px; -fx-font-weight: bold;">
                <font>
                    <Font name="System Bold" size="34"/>
                </font>
            </Label>
            <Label fx:id="welcomeLabel" style="-fx-text-fill: #cbd5e1; -fx-font-size: 16px;"/>
                        <Label text="Live Dashboard"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>

                        <HBox spacing="12">
                                <VBox spacing="6" prefWidth="180" style="-fx-padding: 14; -fx-background-color: #0b5c56; -fx-background-radius: 12;">
                                        <Label text="Inmate Count" style="-fx-text-fill: #d1fae5; -fx-font-size: 13px;"/>
                                        <Label fx:id="inmateCountValue" text="0" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                </VBox>

                                <VBox spacing="6" prefWidth="180" style="-fx-padding: 14; -fx-background-color: #7c2d12; -fx-background-radius: 12;">
                                        <Label text="Alerts" style="-fx-text-fill: #fed7aa; -fx-font-size: 13px;"/>
                                        <Label fx:id="alertsValue" text="0" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                </VBox>

                                <VBox spacing="6" prefWidth="220" style="-fx-padding: 14; -fx-background-color: #1e3a8a; -fx-background-radius: 12;">
                                        <Label text="Court Cases Pending" style="-fx-text-fill: #bfdbfe; -fx-font-size: 13px;"/>
                                        <Label fx:id="courtPendingValue" text="0" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                </VBox>

                                <VBox spacing="6" prefWidth="220" style="-fx-padding: 14; -fx-background-color: #4c1d95; -fx-background-radius: 12;">
                                        <Label text="Capacity" style="-fx-text-fill: #ddd6fe; -fx-font-size: 13px;"/>
                                        <Label fx:id="capacityValue" text="0 / 500" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                </VBox>
            </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Recent Activity" style="-fx-text-fill: #f8fafc; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Button text="Refresh" onAction="#refreshDashboard" style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-background-radius: 8;"/>
                        </HBox>

                        <TableView fx:id="recentActivityTable" prefHeight="430" VBox.vgrow="ALWAYS" style="-fx-background-color: rgba(15,23,42,0.75);">
                                <columns>
                                        <TableColumn fx:id="activityTimeColumn" text="Time" prefWidth="220"/>
                                        <TableColumn fx:id="activityActionColumn" text="Action" prefWidth="220"/>
                                        <TableColumn fx:id="activityDetailsColumn" text="Details" prefWidth="500"/>
                                </columns>
                        </TableView>
        </VBox>
    </center>

</BorderPane>