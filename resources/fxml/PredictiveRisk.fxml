<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.prison.controller.PredictiveRiskController"
      spacing="12" style="-fx-padding: 20; -fx-background-color: #0f172a;">

    <Label text="Predictive Risk &amp; Court Scheduling" style="-fx-text-fill: #f8fafc; -fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Inmate:" style="-fx-text-fill: #e2e8f0;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="inmateCombo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Court Date:" style="-fx-text-fill: #e2e8f0;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <DatePicker fx:id="courtDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Court Time (HH:mm):" style="-fx-text-fill: #e2e8f0;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="courtTimeField" promptText="12:00" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Scheduled By:" style="-fx-text-fill: #e2e8f0;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="scheduledByField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Schedule Court Case" onAction="#scheduleCourtCase"
                style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Back" onAction="#goBack"/>
    </HBox>

    <Label text="Court Scheduling Feed" style="-fx-text-fill: #f8fafc; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TableView fx:id="courtScheduleTable" prefHeight="340">
        <columns>
            <TableColumn fx:id="scheduleIdColumn" text="ID" prefWidth="80"/>
            <TableColumn fx:id="inmateIdColumn" text="Inmate ID" prefWidth="120"/>
            <TableColumn fx:id="courtTimeColumn" text="Court Time" prefWidth="220"/>
            <TableColumn fx:id="scheduledByColumn" text="Scheduled By" prefWidth="220"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold;"/>
</VBox>