<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.prison.controller.VisitorIncidentReportsController"
      spacing="12" style="-fx-padding: 20; -fx-background-color: #0f172a;">

    <Label text="Public Incident Reports" style="-fx-text-fill: #f8fafc; -fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label text="View public safety records related to inmates." style="-fx-text-fill: #cbd5e1;"/>

    <HBox spacing="10">
        <Label text="Filter by inmate:" style="-fx-text-fill: #e2e8f0;"/>
        <ComboBox fx:id="inmateFilterCombo" prefWidth="280"/>
        <Button text="Clear Filter" onAction="#clearFilter"/>
        <Button text="Back" onAction="#goBack"/>
    </HBox>

    <ScrollPane fx:id="reportsScrollPane" fitToWidth="true" prefHeight="380" style="-fx-background: #111827;">
        <content>
            <TableView fx:id="reportsTable" prefHeight="360" style="-fx-background-color: #111827;">
                <columns>
                    <TableColumn fx:id="reportIdColumn" text="Report ID" prefWidth="90"/>
                    <TableColumn fx:id="inmateIdColumn" text="Inmate ID" prefWidth="90"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="200"/>
                    <TableColumn fx:id="dateColumn" text="Date/Time" prefWidth="180"/>
                    <TableColumn fx:id="reportedByColumn" text="Reported By" prefWidth="160"/>
                    <TableColumn fx:id="releaseDateColumn" text="Release Date" prefWidth="130"/>
                </columns>
            </TableView>
        </content>
    </ScrollPane>

    <Label fx:id="statusLabel" style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold;"/>
</VBox>